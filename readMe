snrc-project/
├── snrc-frontend/
└── snrc-backend/

npm create vite@latest snrc-frontend -- --template react
cd snrc-frontend
npm install

npm install react-router-dom axios lucide-react react-helmet-async react-hook-form zod @hookform/resolvers clsx
npm install -D tailwindcss postcss autoprefixer
npx tailwindcss init -p

cd ..

mkdir snrc-backend
cd snrc-backend
npm init -y

npm install express cors helmet morgan dotenv cookie-parser jsonwebtoken bcryptjs multer pg
npm install express-validator slugify
npm install -D nodemon


### Architecture 

