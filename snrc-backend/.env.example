PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=snrc_db
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
COOKIE_NAME=snrc_token
# En production, si le frontend et l'API sont sur des sous-domaines différents
# (ex: www.snrc.td / api.snrc.td), définir le domaine parent partagé pour que
# le cookie CSRF reste lisible côté frontend. Laisser vide en local.
COOKIE_DOMAIN=
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
