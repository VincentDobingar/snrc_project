<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg width="1600" height="800" viewBox="0 0 1600 800" xmlns="http://www.w3.org/2000/svg">
  <title>SNRC favicon</title>
  <desc>Logo SNRC en SVG avec fond transparent</desc>

  <rect width="1600" height="800" fill="none"/>

  <g font-family="Arial, Helvetica, sans-serif" font-weight="900" fill="#3149A3">
    <text x="10" y="540" font-size="520" letter-spacing="-22">S</text>
    <text x="360" y="540" font-size="520" letter-spacing="-18">N</text>
    <text x="835" y="540" font-size="520" letter-spacing="-18">R</text>
    <text x="1220" y="540" font-size="520" letter-spacing="-18">C</text>
  </g>

  <rect x="740" y="20" width="70" height="520" rx="2" fill="#F21D25"/>

  <g fill="#F2CD2E" stroke="#F2CD2E">
    <ellipse cx="683" cy="96" rx="42" ry="18"/>
    <ellipse cx="683" cy="132" rx="42" ry="18"/>
    <ellipse cx="683" cy="168" rx="42" ry="18"/>
    <ellipse cx="683" cy="204" rx="42" ry="18"/>
    <ellipse cx="683" cy="240" rx="42" ry="18"/>
    <ellipse cx="683" cy="276" rx="42" ry="18"/>
    <ellipse cx="683" cy="312" rx="42" ry="18"/>
    <ellipse cx="683" cy="348" rx="42" ry="18"/>
    <ellipse cx="683" cy="384" rx="42" ry="18"/>
    <ellipse cx="683" cy="420" rx="42" ry="18"/>
    <ellipse cx="683" cy="456" rx="42" ry="18"/>
    <ellipse cx="683" cy="492" rx="42" ry="18"/>
    <ellipse cx="683" cy="528" rx="42" ry="18"/>
  </g>

  <polygon points="530,325 565,295 808,545 770,545" fill="white"/>

  <text x="27" y="740"
        font-family="Arial, Helvetica, sans-serif"
        font-size="64"
        font-weight="900"
        letter-spacing="1.5"
        fill="#000000">
    SOCIÉTÉ NATIONALE DE RECOUVREMENT DES CRÉANCES
  </text>
</svg>
